{
  "manifest_version": 3,
  "name": "Email Filer",
  "version": "1.0.0",
  "description": "Adds a Gmail-aligned sidebar on mail.google.com",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-app.js"],
      "run_at": "document_idle"
    }
  ]
}
